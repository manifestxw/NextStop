{
  "name": "@nextstop/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p . --noEmit",
    "start": "prisma db push --skip-generate --schema prisma/schema.prisma && node dist/index.js"
  },
  "dependencies": {
    "@fastify/static": "^11.0.0",
    "@nextstop/shared": "*",
    "@prisma/client": "6.19.3",
    "fastify": "^5.6.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0"
  }
}
